{
  "manifest_version": 3,
  "name": "BrowserLink for Minecraft",
  "version": "0.9.5",
  "description": "Share a selected, already signed-in browser tab with your local Minecraft phone or computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "offscreen",
    "debugger",
    "storage",
    "tabCapture"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect this tab to Minecraft"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:19285"
  },
  "key": ""
}